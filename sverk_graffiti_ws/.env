# ============================================
# Платформа Сверха (если нужна)
# ============================================
SVERK_PORT=3000

# ============================================
# Redis (чат агентов)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ============================================
# ROS 2 для Обриков
# ============================================

# IP реальных роботов Обрик
OBRIK1_IP=192.168.1.101
OBRIK2_IP=192.168.1.102
OBRIK3_IP=192.168.1.103
OBRIK4_IP=192.168.1.104

# Или если через симуляцию
USE_SIMULATION=true
GAZEBO_MASTER_URI=http://localhost:11345

# ROS 2 настройки
ROS_DOMAIN_ID=42
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# ============================================
# Обрики
# ============================================

# Размеры рабочей зоны (метры)
WALL_WIDTH=2.0
WALL_HEIGHT=1.5

# Высота стола для рисования
TABLE_HEIGHT=0.8

# Скорость движения манипуляторов
ARM_SPEED_SCALE=0.5

# ============================================
# Агенты
# ============================================
MAX_DEBATE_ROUNDS=10
CONSENSUS_THRESHOLD=0.75

# ... предыдущие ...
# VLM-камера
VLM_CAMERA_URL=http://192.168.1.200:8080/stream   # URL видеопотока
# Промпт (вводится через интерфейс, но можно и через переменную)
DEFAULT_PROMPT="Нарисуйте абстрактную композицию в стиле супрематизма"
# Kill switch топик
KILL_SWITCH_TOPIC=/kill_switch
# Размеры полотна (метры)
CANVAS_WIDTH=2.0
CANVAS_HEIGHT=2.0
# Высота полотна над полом
CANVAS_BOTTOM=0.5
# Минимальный заряд батареи
MIN_BATTERY=40